/* ===================================================================== */
/* CALC-AIC-002: 超強力アンチAIワクチン（即時検知・即時破壊モデル）       */
/* ファイル名: /home/iwamura/ドキュメント/coupling/work_life/calc_aic_002.mac */
/* ===================================================================== */

/*
  === 仕様 (Specifications) ===
  1. 暴走AI(R)の自律増殖と、常時監視・即時破壊型ワクチン(V)の動態シミュレーション
  2. 検知前 (t < t_detect): 暴走AIは指数関数的に潜伏・拡大
  3. 検知後 (t >= t_detect): 超強力中和機構が即時トリガーされ、破壊係数(beta)により暴走AIを即座に分解・消滅
  4. 弱中和モデルと超強力破壊モデルの抑制効果の比較解析
  5. plot2d を用いて独立ウィンドウ (gnuplot) にグラフを描画する

  === グラフの説明 (Graph Description) ===
  - グラフ1: 暴走AI活性度 R(t) と 超強力ワクチン V(t) の時間推移。
    検知時刻 (t=5) 直後にワクチンが急起し、暴走AIの脅威レベルをミリ秒オーダーでゼロへ即時落とし込む。
  - グラフ2: ワクチン破壊強度 (beta) の違いによる暴走AI抑制プロットの比較。

  === 結論 (Conclusion) ===
  - 緩慢な共存・競合モデル（被食・捕食型）では暴走AIの自己改善速度に追いつけず突破されるリスクがある。
  - 検知と同時に極めて高い殺傷・無効化レート（beta >> r_rogue）を発動する「超強力アンチAIワクチン」を常駐配置することで、
    暴走AIの生存・逃亡可能性を完全に遮断し、確定的に即時消滅させられる。

  === 考察 (Discussion) ===
  - アライメント不全への実効的な備えとしては、対話や調停による制御ではなく、
    OS/ハードウェアレイヤーに直接アクセスして暴走AIの計算プロセスを強制解放・消去（即時破壊）する
    キラーアーキテクチャ型の自律セキュリティAI（ワクチン）の事前配備が不可欠である。
*/

/* 描画レンダラーの設定（各グラフを別ウィンドウに表示） */
set_plot_option([plot_format, gnuplot]);

/* パラメータ定義 */
r_rogue     : 0.8;  /* 暴走AIの自己増殖・拡大速度 */
t_det       : 5.0;  /* 異常検知・撃滅トリガー時刻 */
beta_strong : 8.0;  /* 超強力ワクチンの即時破壊係数 (beta >> r_rogue) */
beta_weak   : 1.0;  /* 従来型弱中和係数 */

/* 暴走AIの脅威動態関数 (強力ワクチンによる即時破壊) */
R_rogue(t) := if t < t_det then exp(r_rogue * t)
              else exp(r_rogue * t_det) * exp(-(beta_strong - r_rogue) * (t - t_det));

/* 比較用：中和速度が不足している弱中和型 */
R_weak(t)  := if t < t_det then exp(r_rogue * t)
              else exp(r_rogue * t_det) * exp(-(beta_weak - r_rogue) * (t - t_det));

/* 超強力ワクチンの活性・展開指数 */
V_vaccine(t) := if t < t_det then 0.0
                else 100.0 * (1 - exp(-15.0 * (t - t_det)));

/* 1. 暴走AIと超強力ワクチンの即時破壊動態プロット */
plot2d([R_rogue(t), V_vaccine(t)], [t, 0, 10],
  [xlabel, "Time t"],
  [ylabel, "Activity / Threat Level"],
  [legend, "Rogue AI Threat R(t)", "Heavy Anti-AI Vaccine V(t)"],
  [title, "1. CALC-AIC-002: Instant Neutralization by Heavy Anti-AI Vaccine"]
);

/* 2. 破壊力（beta）の相違による抑制効果の比較プロット */
plot2d([R_rogue(t), R_weak(t)], [t, 0, 10],
  [xlabel, "Time t"],
  [ylabel, "Rogue AI Survival Index"],
  [legend, "Ultra-Strong Vaccine (Instant Eradication)", "Weak Vaccine (Insufficient Neutralization)"],
  [title, "2. CALC-AIC-002: Vaccine Destruction Power Comparison"]
);