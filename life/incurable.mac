/* ===================================================================== */
/* 難病・不治の病（ALS・アルツハイマー病等）数理モデル解析スクリプト     */
/* ファイル名: incurable_diseases.mac                                    */
/* ===================================================================== */

/*
  === 仕様 (Specifications) ===
  1. ALS（筋萎縮性側索硬化症）における運動ニューロン残存率の指数減衰モデル
  2. アルツハイマー病におけるアミロイドβ（Aβ）蓄積とシグモイド(Logistic)成長モデル
  3. 薬物治療介入による神経変性進行遅延効果の比較シミュレーション
  4. 各モデルのプロットは plot2d を用い、独立したウィンドウ(gnuplot)で表示する

  === グラフの説明 (Graph Description) ===
  - グラフ1: 経過時間 t (年) に対するALS患者の運動ニューロン残存率 N(t) (%)
  - グラフ2: 経過時間 t (年) に対する脳内アミロイドβ蓄積量 A(t) (相対値)
  - グラフ3: 治療非介入時と抗体薬・神経保護薬投与時の病状進行指数の推移比較

  === 結論 (Conclusion) ===
  - ALSモデル: 運動ニューロンは発症後、指数関数的に急激に減少するが、早期の治療介入により半減期を延ばすことが可能。
  - アルツハイマー病モデル: Aβ蓄積は発症前の無症状期からシグモイド曲線を描いて緩やかに増加し、一定値で飽和する。
  - 治療介入効果: 病状発症直後の早期投与開始が、発症遅延および機能維持において最も高い臨床的効果を示す。

  === 考察 (Discussion) ===
  - 神経変性疾患の治療設計では、不可逆的な神経細胞脱落が起こる前の「先取り治療（Pre-symptomatic Intervention）」の数理的有効性が示された。
  - 薬物動態・病理動態を連動させた結合モデル（PK/PD/Disease Progression Model）を適用することで、臨床試験の設計最適化に寄与できる。
*/

/* 描画レンダラーの設定（各グラフを別ウィンドウに表示） */
set_plot_option([plot_format, gnuplot]);

/* --------------------------------------------------------------------- */
/* 1. ALS: 運動ニューロン脱落モデル                                      */
/* --------------------------------------------------------------------- */
N0 : 100;    /* 初期正常ニューロン割合 (%) */
k_als : 0.4; /* 進行速度定数 (1/year) */
N(t) := N0 * exp(-k_als * t);

plot2d(N(t), [t, 0, 10],
  [xlabel, "Time t (years)"],
  [ylabel, "Motor Neuron Survival Rate N(t) (%)"],
  [title, "1. ALS: Motor Neuron Loss Kinetics"]
);

/* --------------------------------------------------------------------- */
/* 2. アルツハイマー病: アミロイドβ蓄積ロジスティックモデル              */
/* --------------------------------------------------------------------- */
A_max : 1.0;   /* 飽和蓄積量 */
r : 0.25;      /* 凝集・蓄積速度定数 */
t50 : 15;      /* 50%蓄積に達する時間 (years) */
A(t) := A_max / (1 + exp(-r * (t - t50)));

plot2d(A(t), [t, 0, 40],
  [xlabel, "Time t (years)"],
  [ylabel, "Amyloid-beta Accumulation A(t)"],
  [title, "2. Alzheimer Disease: Amyloid-beta Aggregation Model"]
);

/* --------------------------------------------------------------------- */
/* 3. 神経保護薬投与による病状進行比較モデル                             */
/* --------------------------------------------------------------------- */
/* P_control: 無治療時の病理スコア, P_treated: 5年目から治療開始時のスコア */
P_control(t) := 100 * (1 - exp(-0.15 * t));
P_treated(t) := if t < 5 then 100 * (1 - exp(-0.15 * t))
                else 100 * (1 - exp(-0.15 * 5)) + 100 * (1 - exp(-0.05 * (t - 5)));

plot2d([P_control(t), P_treated(t)], [t, 0, 20],
  [xlabel, "Time t (years)"],
  [ylabel, "Pathology Score P(t)"],
  [legend, "Control (No Treatment)", "Therapeutic Intervention at t=5"],
  [title, "3. Disease Progression Delay with Therapeutic Intervention"]
);
