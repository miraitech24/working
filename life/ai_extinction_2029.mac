/* ===================================================================== */
/* AI破局シナリオおよび200年人類存続可能性数理モデル                     */
/* ファイル名: /home/iwamura/ドキュメント/coupling/work_life/ai_extinction_2029.mac */
/* ===================================================================== */

/*
  === 仕様 (Specifications) ===
  1. 2029年ターゲットのAI大破局（Existential Risk）累積確率モデルの計算
     累積確率関数: P_2029(t) = 1 - exp(-lambda_ai * (t - 2024)^gamma_ai)
     (2024年から2029年にかけたリスクの幾何級数的な上昇をモデル化)
  2. 200年スケール（2000年〜2200年）における複合破局リスク（AI、気候、核等）と人類存続確率モデル
     存続確率関数: S_200(t) = exp(-integral(h(tau), tau, 2000, t))
  3. 各プロットは plot2d を用い、独立した gnuplot ウィンドウに描画する。

  === グラフの説明 (Graph Description) ===
  - グラフ1: 2024年から2029年にかけるAIアライメント不全・超知能出現による累積破局リスク P_2029(t)
  - グラフ2: 2000年から2200年までの200年間における人類存続確率 S_200(t) の推移

  === 結論 (Conclusion) ===
  - 2029年シナリオモデルでは、能力の超線形成長と安全策の遅れにより、2029年前後にリスク指数が急激に上昇する（臨界点）。
  - 200年長期モデルにおいては、累積的なリスクハザード h(t) の存在により、対策を講じない場合の200年後の生存確率は大幅に低下する。

  === 考察 (Discussion) ===
  - 「作戦」として知能爆発やインフラ乗っ取りなどの単一シナリオを議論するよりも、数理的にはハザード率 h(t) を押し下げる技術的アライメント（能力キャップ、監視・中和機能）の導入速度が存続確率の維持に直結する。
  - 2029年までの短期的急変期および今後200年の長期的危機期双方において、数理モデルに基づいた早期かつ連続的なガバナンスが必須である。
*/

/* 描画レンダラーの設定（各グラフを別ウィンドウに表示） */
set_plot_option([plot_format, gnuplot]);

/* 1. 2029年AIアライメント破局累積リスクモデル */
lambda_ai : 0.05;
gamma_ai  : 2.5;
P_2029(t) := 1 - exp(-lambda_ai * (t - 2024)^gamma_ai);

plot2d(P_2029(t), [t, 2024, 2029],
  [xlabel, "Year"],
  [ylabel, "Cumulative Existential Risk Index"],
  [title, "1. AI Existential Risk Accumulation Scenario (2024-2029)"]
);

/* 2. 200年スケール (2000-2200) 人類存続確率モデル */
/* ハザード率 h(t) が時間の経過とともに複合リスクで徐々に増加すると仮定 */
h(t) := 0.002 + 0.00005 * (t - 2000);
/* 存続確率 S(t) = exp(- (0.002*(t-2000) + 0.000025*(t-2000)^2)) */
S_200(t) := exp(-(0.002 * (t - 2000) + 0.000025 * (t - 2000)^2));

plot2d(S_200(t), [t, 2000, 2200],
  [xlabel, "Year"],
  [ylabel, "Human Survival Probability S(t)"],
  [title, "2. 200-Year Scale Human Survival Probability Model (2000-2200)"]
);